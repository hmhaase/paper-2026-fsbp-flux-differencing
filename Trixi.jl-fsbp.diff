@@ -0,0 +1,33 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+function calc_volume_integral!(backend::Nothing, du, u, mesh,
+                               have_nonconservative_terms, equations,
+                               volume_integral::VolumeIntegralFluxDifferencing,
+                               dg::DGFSBP, cache)
+    @threaded for element in eachelement(dg, cache)
+        flux_differencing_kernel!(du, u, element, typeof(mesh),
+                                  have_nonconservative_terms, equations,
+                                  volume_integral.volume_flux, dg, cache)
+    end
+
+    return nothing
+end
+
+function calc_volume_integral!(backend::Nothing, du, u, mesh,
+                               have_nonconservative_terms, equations,
+                               volume_integral::VolumeIntegralWeakForm,
+                               dg::DGFSBP, cache)
+    @threaded for element in eachelement(dg, cache)
+        weak_form_kernel!(du, u, element, typeof(mesh),
+                          have_nonconservative_terms, equations,
+                          dg, cache)
+    end
+
+    return nothing
+end
+end # @muladd
diff --git a/src/solvers/fsbp/cell_basis.jl b/src/solvers/fsbp/cell_basis.jl
new file mode 100644
index 0000000..984edec
--- /dev/null
+++ b/src/solvers/fsbp/cell_basis.jl
@@ -0,0 +1,278 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+"Marker for the face at the negative end of an axis (left in 1D)."
+struct Negative end
+"Marker for the face at the positive end of an axis (right in 1D)."
+struct Positive end
+
+"""
+    CellBasis{RealT}
+
+Base type for a basis on one element. Must implement:
+- real(::CellBasis)
+- ndofs_per_element(::CellBasis)
+- eachnode(::CellBasis)
+- index_ndims(::CellBasis)
+"""
+abstract type CellBasis{RealT} end
+
+"""
+    LineBasis{RealT} <: CellBasis{RealT}
+
+A 1D SBP operator (one node set + its matrices/boundary operators). In addition to the
+`CellBasis` methods, must implement:
+- get_nodes(::LineBasis)
+- nnodes(::LineBasis)
+- quadrature_weights(::LineBasis)
+- interpolation_matrix(::LineBasis, nodes_out)
+- boundary_value!, apply_surface_lift_line!, boundary_coordinate
+
+Fields:
+- boundary_lift    # M⁻¹Rᵀ, [nnodes, 2] (Lobatto: R = [e_1, e_N]ᵀ)
+- derivative_split # 2D - M⁻¹B, skew-symmetric split form (flux differencing)
+- derivative_dhat  # weak form, dhat[j,n] = -D'[j,n] w[n] / w[j]
+"""
+abstract type LineBasis{RealT} <: CellBasis{RealT} end
+
+@inline index_ndims(basis::CellBasis) = index_ndims(typeof(basis))
+@inline index_ndims(::Type{<:LineBasis}) = 1
+
+"""
+    LobattoLikeCellBasis <: LineBasis
+
+Basis including boundary nodes with quadrature weights similar to a Gauss-Lobatto
+quadrature rule.
+"""
+struct LobattoLikeCellBasis{RealT <: Real} <: LineBasis{RealT}
+    _nodes::Vector{RealT}
+    _weights::Vector{RealT}
+
+    "Matrix L such that \$L^T M u = [u_L, u_R]^T\$, that is \$L = M⁻¹ [e_1, e_N]\$"
+    boundary_lift::Matrix{RealT} # lhat
+
+    derivative_split::Matrix{RealT} # 2D - M⁻¹B, skew-symmetric split form
+    derivative_dhat::Matrix{RealT} # weak form matrix "dhat"
+
+    """
+        calc_interpolation_matrix(nodes_out)
+
+    Return the interpolation matrix from the basis nodes to `nodes_out`.
+    `nodes_out` are in the same coordinate space as the basis nodes (physical space).
+    The basis nodes are captured in the callable, it takes only the target nodes.
+    Returns a matrix `V` of size `(length(nodes_out), nnodes)` such that
+    `u_target = V * u_basis` interpolates from basis node values to target node values.
+    """
+    calc_interpolation_matrix::Any
+end
+
+get_nodes(basis::LobattoLikeCellBasis) = basis._nodes
+eachnode(basis::LobattoLikeCellBasis) = Base.OneTo(nnodes(basis))
+nnodes(basis::LobattoLikeCellBasis) = length(basis._nodes)
+ndofs_per_element(basis::LobattoLikeCellBasis) = nnodes(basis)
+quadrature_weights(basis::LobattoLikeCellBasis) = basis._weights
+
+# TODO: Consider specifying a formal description of where the new nodes should be
+# for example n gauss lobatto nodes within the domain of the basis and then caching
+# the vandermonde matrix
+#
+# Currently required for error calculation and plotting
+function interpolation_matrix(basis::LobattoLikeCellBasis, nodes_out)
+    basis.calc_interpolation_matrix(nodes_out)
+end
+
+@inline Base.real(::LobattoLikeCellBasis{RealT}) where {RealT <: Real} = RealT
+
+@inline boundary_coordinate(basis::LobattoLikeCellBasis, ::Negative) = basis._nodes[1]
+@inline boundary_coordinate(basis::LobattoLikeCellBasis, ::Positive) = basis._nodes[end]
+
+@inline function boundary_value!(dest, u_line, ::LobattoLikeCellBasis, ::Negative)
+    dest .= @view u_line[:, 1]
+end
+@inline function boundary_value!(dest, u_line, ::LobattoLikeCellBasis, ::Positive)
+    dest .= @view u_line[:, end]
+end
+
+# `boundary_lift` is nonzero only at the two endpoint nodes for Lobatto-like bases.
+@inline function apply_surface_lift_line!(du_line, sflux_neg, sflux_pos,
+                                          basis::LobattoLikeCellBasis, equations)
+    boundary_lift = basis.boundary_lift
+    n = nnodes(basis)
+    factor_neg = boundary_lift[1, 1]
+    factor_pos = boundary_lift[n, 2]
+    for v in eachvariable(equations)
+        du_line[v, 1] = du_line[v, 1] - sflux_neg[v] * factor_neg
+        du_line[v, n] = du_line[v, n] + sflux_pos[v] * factor_pos
+    end
+end
+
+function LobattoLikeCellBasis(nodes, weights, derivative_matrix,
+                              calc_interpolation_matrix)
+    RealT = eltype(nodes)
+    @assert RealT <: Real
+    boundary_lift = zeros(RealT, length(nodes), 2)
+    boundary_lift[1, 1] = 1 / weights[1]
+    boundary_lift[end, end] = 1 / weights[end]
+    # 2D - M⁻¹B
+    #
+    # M⁻¹ = diagm(1 ./ weights)
+    # B = diagm(-1, 0, ..., 0, 1)
+    # => M⁻¹B = diagm(-1/w_1, 0, ..., 0, 1/w_end)
+    derivative_split = 2 * derivative_matrix
+    derivative_split[1, 1] -= -1 / weights[1]
+    derivative_split[end, end] -= 1 / weights[end]
+
+    # Weak form matrix: dhat[j,n] = -D'[j,n] * w[n] / w[j]
+    derivative_dhat = -derivative_matrix' .* weights' ./ weights
+
+    LobattoLikeCellBasis{RealT}(nodes, weights, boundary_lift, derivative_split,
+                                derivative_dhat, calc_interpolation_matrix)
+end
+
+"""
+    LobattoLegendreCellBasis
+
+Construct the standard Lobatto Legendre Basis with Gauss-Lobatto quadrature.
+"""
+function LobattoLegendreCellBasis(polydeg::Int, pos::RealT,
+                                  dx::RealT) where {RealT <: Real}
+    nnodes_ = polydeg + 1
+
+    nodes, weights = gauss_lobatto_nodes_weights(nnodes_, RealT)
+    J = dx / 2
+    nodes = J .* nodes .+ pos
+    weights = abs(J) .* weights
+
+    boundary_lift = zeros(RealT, nnodes_, 2)
+    boundary_lift[:, 1] = calc_Lhat(calc_L(J * -one(RealT) + pos, nodes, weights),
+                                    weights)
+    boundary_lift[:, 2] = calc_Lhat(calc_L(J * one(RealT) + pos, nodes, weights),
+                                    weights)
+
+    derivative_matrix = polynomial_derivative_matrix(nodes)
+    derivative_split = calc_Dsplit(derivative_matrix, weights)
+    derivative_dhat = calc_Dhat(derivative_matrix, weights)
+
+    calc_interp = nodes_out -> polynomial_interpolation_matrix(nodes, nodes_out)
+
+    LobattoLikeCellBasis{RealT}(nodes, weights, boundary_lift, derivative_split,
+                                derivative_dhat, calc_interp)
+end
+
+"""
+    GeneralSBPCellBasis <: LineBasis
+
+Basis for general SBP operators where nodes need not include element boundaries.
+The boundary interpolation/extrapolation operator R is stored as `boundary_interpolation`
+(shape `(2, nnodes)`, row 1 = left/−x, row 2 = right/+x) and maps node values to boundary
+values.  `boundary_lift = M⁻¹Rᵀ` (shape `(nnodes, 2)`) is pre-computed for the surface
+integral hot path.
+"""
+struct GeneralSBPCellBasis{RealT <: Real} <: LineBasis{RealT}
+    _nodes::Vector{RealT}
+    _weights::Vector{RealT}
+    "M⁻¹Rᵀ, size (nnodes, 2); same name and layout as `LobattoLikeCellBasis.boundary_lift`"
+    boundary_lift::Matrix{RealT}
+    "Boundary evaluation operator R, size (2, nnodes); row 1 left (−x), row 2 right (+x)"
+    boundary_interpolation::Matrix{RealT}
+    "Physical coordinates [x_left, x_right] of the element boundaries"
+    boundary_nodes::SVector{2, RealT}
+    derivative_split::Matrix{RealT}
+    derivative_dhat::Matrix{RealT}
+    calc_interpolation_matrix::Any
+end
+
+get_nodes(basis::GeneralSBPCellBasis) = basis._nodes
+eachnode(basis::GeneralSBPCellBasis) = Base.OneTo(nnodes(basis))
+nnodes(basis::GeneralSBPCellBasis) = length(basis._nodes)
+ndofs_per_element(basis::GeneralSBPCellBasis) = nnodes(basis)
+quadrature_weights(basis::GeneralSBPCellBasis) = basis._weights
+
+function interpolation_matrix(basis::GeneralSBPCellBasis, nodes_out)
+    basis.calc_interpolation_matrix(nodes_out)
+end
+
+@inline Base.real(::GeneralSBPCellBasis{RealT}) where {RealT <: Real} = RealT
+
+@inline boundary_coordinate(basis::GeneralSBPCellBasis,
+::Negative) = basis.boundary_nodes[1]
+@inline boundary_coordinate(basis::GeneralSBPCellBasis,
+::Positive) = basis.boundary_nodes[2]
+
+@inline function boundary_value!(dest, u_line, basis::GeneralSBPCellBasis, ::Negative)
+    mul!(dest, u_line, @view basis.boundary_interpolation[1, :])
+end
+@inline function boundary_value!(dest, u_line, basis::GeneralSBPCellBasis, ::Positive)
+    mul!(dest, u_line, @view basis.boundary_interpolation[2, :])
+end
+
+@inline function apply_surface_lift_line!(du_line, sflux_neg, sflux_pos,
+                                          basis::GeneralSBPCellBasis, equations)
+    boundary_lift = basis.boundary_lift
+    for i in eachnode(basis)
+        for v in eachvariable(equations)
+            du_line[v, i] = (du_line[v, i] - sflux_neg[v] * boundary_lift[i, 1] +
+                             sflux_pos[v] * boundary_lift[i, 2])
+        end
+    end
+end
+
+function GeneralSBPCellBasis(nodes, boundary_nodes, weights, D,
+                             calc_interpolation_matrix)
+    RealT = eltype(nodes)
+    n = length(nodes)
+    @assert size(D) == (n, n)
+
+    # Derive R by evaluating the interpolation operator at the physical boundary points
+    boundary_interpolation = calc_interpolation_matrix(boundary_nodes)
+    @assert size(boundary_interpolation) == (2, n)
+
+    # boundary_lift = M⁻¹Rᵀ:  lift[i,j] = R[j,i] / w[i]
+    boundary_lift = Matrix{RealT}(undef, n, 2)
+    for j in 1:2, i in 1:n
+        boundary_lift[i, j] = boundary_interpolation[j, i] / weights[i]
+    end
+
+    # derivative_split = 2D − M⁻¹B,  B = Rᵀ diag(−1, 1) R
+    # [-1,1] .* boundary_interpolation scales row 1 by -1 and row 2 by +1 (diag(-1,1)*R)
+    # then (n×2)*(2×n) gives B
+    B = boundary_interpolation' * ([-one(RealT), one(RealT)] .* boundary_interpolation)
+    derivative_split = 2 * D - (1 ./ weights) .* B
+
+    # derivative_dhat = −Dᵀ .* wᵀ ./ w  (weak form matrix)
+    derivative_dhat = -D' .* weights' ./ weights
+
+    GeneralSBPCellBasis{RealT}(Vector{RealT}(nodes), Vector{RealT}(weights),
+                               Matrix{RealT}(boundary_lift),
+                               Matrix{RealT}(boundary_interpolation),
+                               SVector{2, RealT}(boundary_nodes),
+                               Matrix{RealT}(derivative_split),
+                               Matrix{RealT}(derivative_dhat),
+                               calc_interpolation_matrix)
+end
+
+"""
+    TensorProductCellBasis{NDIMS, RealT, B} <: CellBasis{RealT}
+
+Tensor product of `NDIMS` `LineBasis`es (one per axis; types may differ).
+"""
+struct TensorProductCellBasis{NDIMS, RealT,
+                              B <: Tuple{Vararg{LineBasis{RealT}}}} <: CellBasis{RealT}
+    bases::B
+end
+
+function TensorProductCellBasis(bases::Tuple)
+    RealT = real(first(bases))
+    return TensorProductCellBasis{length(bases), RealT, typeof(bases)}(bases)
+end
+
+@inline index_ndims(::Type{<:TensorProductCellBasis{NDIMS}}) where {NDIMS} = NDIMS
+@inline Base.real(::TensorProductCellBasis{NDIMS, RealT}) where {NDIMS, RealT} = RealT
+@inline ndofs_per_element(basis::TensorProductCellBasis) = prod(nnodes, basis.bases)
+@inline eachnode(basis::TensorProductCellBasis) = CartesianIndices(map(nnodes,
+                                                                       basis.bases))
+end # @muladd
diff --git a/src/solvers/fsbp/cell_basis_constructors.jl b/src/solvers/fsbp/cell_basis_constructors.jl
new file mode 100644
index 0000000..106369e
--- /dev/null
+++ b/src/solvers/fsbp/cell_basis_constructors.jl
@@ -0,0 +1,183 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+abstract type CellBasisConstructor{CellBasisT} end
+
+cell_basis_type(::Type{<:CellBasisConstructor{B}}) where {B} = B
+"""
+    build_cell_basis(constructor::CellBasisConstructor, pos, dx)
+
+Build the basis for one cell centered at `pos` with width `dx`.
+"""
+build_cell_basis(::CellBasisConstructor, pos, dx) = error("not implemented")
+
+@inline Base.real(::C) where {RealT, B <: CellBasis{RealT},
+C <: CellBasisConstructor{B}} = RealT
+
+struct LobattoLegendreCellBasisConstructor{RealT} <:
+       CellBasisConstructor{LobattoLikeCellBasis{RealT}}
+    """
+        calc_poly_degree(pos, dx)
+
+    Calculate the degree of the polynomial to be constructed at cell with position `pos`
+    and length `dx`.
+    """
+    calc_poly_degree::Function
+
+    function LobattoLegendreCellBasisConstructor{RealT}(calc_poly_degree) where {RealT <:
+                                                                                 Real}
+        new(calc_poly_degree)
+    end
+end
+
+function build_cell_basis(constructor::LobattoLegendreCellBasisConstructor{RealT},
+                          pos, dx) where {RealT <: Real}
+    polydeg = constructor.calc_poly_degree(pos, dx)
+    return LobattoLegendreCellBasis(polydeg, pos, dx)
+end
+
+"""
+    ReferenceCellBasisConstructor{RealT, CellBasisT}
+
+Wraps one fixed, precomputed reference-domain SBP operator (`D`, `x`, `w` on `domain`)
+and affinely maps it to each cell, rather than recomputing an operator per cell like
+`LobattoLegendreCellBasisConstructor` does.
+"""
+struct ReferenceCellBasisConstructor{RealT, CellBasisT <: CellBasis{RealT}} <:
+       CellBasisConstructor{CellBasisT}
+    D::Matrix{RealT}
+    x::Vector{RealT}
+    w::Vector{RealT}
+    calc_interpolation_matrix::Any
+    domain::Tuple{RealT, RealT}
+
+    function ReferenceCellBasisConstructor{RealT, CellBasisT}(D, x, w,
+                                                              calc_interpolation_matrix,
+                                                              domain::Tuple{RealT,
+                                                                            RealT}) where {
+                                                                                           RealT <:
+                                                                                           Real,
+                                                                                           CellBasisT <:
+                                                                                           CellBasis{RealT}
+                                                                                           }
+        @assert size(D, 1) == size(D, 2) == length(x) == length(w)
+        @assert domain[1] < domain[2]
+        new{RealT, CellBasisT}(Matrix{RealT}(D), Vector{RealT}(x), Vector{RealT}(w),
+                               calc_interpolation_matrix, domain)
+    end
+end
+
+# Shared helper: map reference-domain SBP operators to physical space for an element at
+# `pos` with width `dx`.  Works for any constructor with fields D, x, w,
+# calc_interpolation_matrix, domain.
+function _map_to_physical(constructor, pos, dx)
+    a, b = constructor.domain
+    scale = dx / (b - a)
+    mid_ref = (a + b) / 2
+    nodes = scale .* (constructor.x .- mid_ref) .+ pos
+    weights = scale .* constructor.w
+    D_phys = constructor.D ./ scale
+    phys_to_ref = nodes_out -> constructor.calc_interpolation_matrix((nodes_out .- pos) ./
+                                                                     scale .+ mid_ref)
+    return nodes, weights, D_phys, phys_to_ref
+end
+
+# The one place the two `CellBasis` families differ: how to build the final basis
+# from the mapped (nodes, weights, D_phys, interp) tuple.
+function _build_cell_basis(::Type{<:LobattoLikeCellBasis},
+                           nodes, weights, D_phys, interp, pos, dx)
+    LobattoLikeCellBasis(nodes, weights, D_phys, interp)
+end
+
+function _build_cell_basis(::Type{<:GeneralSBPCellBasis},
+                           nodes, weights, D_phys, interp, pos, dx)
+    RealT = eltype(nodes)
+    J = dx / 2
+    boundary_nodes = SVector{2, RealT}(pos - J, pos + J)
+    GeneralSBPCellBasis(nodes, boundary_nodes, weights, D_phys, interp)
+end
+
+function build_cell_basis(constructor::ReferenceCellBasisConstructor{RealT, CellBasisT},
+                          pos, dx) where {RealT <: Real, CellBasisT}
+    nodes, weights, D_phys, interp = _map_to_physical(constructor, pos, dx)
+    return _build_cell_basis(CellBasisT, nodes, weights, D_phys, interp, pos, dx)
+end
+
+struct MixedCellBasisConstructor{RealT, CellBasisT <: CellBasis{RealT},
+                                 Constructors <: NamedTuple} <:
+       CellBasisConstructor{CellBasisT}
+    constructors::Constructors
+    selector::Function
+
+    function MixedCellBasisConstructor{RealT, CellBasisT, Constructors}(constructors::Constructors,
+                                                                        selector::Function) where {
+                                                                                                   RealT <:
+                                                                                                   Real,
+                                                                                                   CellBasisT <:
+                                                                                                   CellBasis{RealT},
+                                                                                                   Constructors <:
+                                                                                                   NamedTuple
+                                                                                                   }
+        for name in keys(constructors)
+            ctor = getfield(constructors, name)
+            @assert ctor isa CellBasisConstructor{<:CellBasis{RealT}} ||
+                    error("Constructor '$name' is $(typeof(ctor)), expected CellBasisConstructor{<:CellBasis{$RealT}}")
+        end
+        new{RealT, CellBasisT, Constructors}(constructors, selector)
+    end
+end
+
+function MixedCellBasisConstructor(constructors::Constructors,
+                                   selector::Function) where {Constructors <:
+                                                              NamedTuple}
+    CellBasisT = Union{map(ctor -> cell_basis_type(typeof(ctor)),
+                           Tuple(constructors))...}
+    RealT = real(first(constructors))
+    MixedCellBasisConstructor{RealT, CellBasisT, Constructors}(constructors, selector)
+end
+
+function build_cell_basis(c::MixedCellBasisConstructor, pos, dx)
+    chosen = c.selector(c.constructors, pos, dx)
+    return build_cell_basis(chosen, pos, dx)
+end
+
+"""
+    TensorProductCellBasisConstructor{NDIMS, Ctors, BasisT}
+
+Builds a `TensorProductCellBasis` from one 1D constructor per axis. `pos` and `dx` are
+indexed per axis (`pos[d]`, `dx[d]`), so cells need not be square.
+"""
+struct TensorProductCellBasisConstructor{NDIMS, Ctors <: Tuple,
+                                         BasisT <: CellBasis} <:
+       CellBasisConstructor{BasisT}
+    constructors::Ctors
+end
+
+function TensorProductCellBasisConstructor(constructors::Tuple)
+    RealT = real(first(constructors))
+    basis_types = map(c -> cell_basis_type(typeof(c)), constructors)
+    # Varying the basis across elements needs a `MixedCellBasisConstructor` *of* tensor
+    # constructors, not a tensor product of mixed ones. TODO: support that.
+    all(isconcretetype, basis_types) ||
+        error("tensor-product cell bases need one concrete basis type per axis")
+    BasisT = TensorProductCellBasis{length(constructors), RealT, Tuple{basis_types...}}
+    return TensorProductCellBasisConstructor{length(constructors), typeof(constructors),
+                                             BasisT}(constructors)
+end
+
+function build_cell_basis(c::TensorProductCellBasisConstructor{NDIMS}, pos,
+                          dx) where {NDIMS}
+    bases = ntuple(d -> build_cell_basis(c.constructors[d], pos[d], dx[d]), Val(NDIMS))
+    return TensorProductCellBasis(bases)
+end
+
+# Wrap a 1D constructor into an isotropic `NDIMS`-axis tensor product; leave a tensor one.
+as_tensor(c::TensorProductCellBasisConstructor, ::Val) = c
+function as_tensor(c::CellBasisConstructor, ::Val{NDIMS}) where {NDIMS}
+    return TensorProductCellBasisConstructor(ntuple(_ -> c, Val(NDIMS)))
+end
+end # @muladd
diff --git a/src/solvers/fsbp/containers.jl b/src/solvers/fsbp/containers.jl
new file mode 100644
index 0000000..88729c4
--- /dev/null
+++ b/src/solvers/fsbp/containers.jl
@@ -0,0 +1,69 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+"""
+    WrappedArray{NDIMS, T, A, WA}
+
+A ragged (jagged) array: unlike a regular `Array`, each element can have its own
+node count per dimension. Backed by a single flat vector.
+
+Two ways to index: `u[v, i..., element]` for a single value (`v` = variable,
+`i...` = node position per dimension, `element` = which element), or `u[element]`
+for a view of that element's whole data, shaped `(nvars, nodes...)`.
+"""
+struct WrappedArray{NDIMS, T, A, WA}
+    nvars::Int
+    # Node count per dimension per element; need not be equal across dimensions.
+    num_nodes_in_element::Vector{NTuple{NDIMS, Int}}
+    # Start of each element in `a`: the running sum of nvars * prod(nnodes(bases[k])),
+    # beginning at 0.
+    offsets::Vector{Int}
+    a::A
+
+    function WrappedArray(::Val{NDIMS}, nvars, num_nodes_in_element, offsets,
+                          a::A) where {NDIMS, T, A <: AbstractVector{T}}
+        WA = Trixi.storage_type(a)
+        new{NDIMS, T, A, WA}(nvars, num_nodes_in_element, offsets, a)
+    end
+end
+
+Base.eltype(::WrappedArray{NDIMS, T, A, WA}) where {NDIMS, T, A, WA} = T
+
+trixi_backend(::WrappedArray) = nothing
+
+@inline function convert_index(a::WrappedArray, (i_vars, i_dims..., element))
+    LinearIndices((a.nvars, a.num_nodes_in_element[element]...))[i_vars, i_dims...] +
+    a.offsets[element]
+end
+
+function Base.getindex(a::WrappedArray{NDIMS, T, A, WA},
+                       element::Int) where {NDIMS, T, A <: AbstractVector{T}, WA}
+    o = a.offsets[element]
+    len = a.nvars * prod(a.num_nodes_in_element[element])
+    # stack-allocated view into this element's slice, shaped (nvars, nodes...)
+    reshape(view(a.a, (o + 1):(o + len)), (a.nvars, a.num_nodes_in_element[element]...))
+end
+
+function Base.getindex(a::WrappedArray{NDIMS, T, A, WA},
+                       idcs...) where {NDIMS, T,
+                                       A <: AbstractVector{T}, WA}
+    a.a[convert_index(a, idcs)]
+end
+
+function Base.getindex(a::WrappedArray{NDIMS, T, A, WA},
+                       ::EllipsisNotation.Ellipsis,
+                       element::Int) where {NDIMS, T,
+                                            A <: AbstractVector{T}, WA}
+    a[element]
+end
+
+function Base.setindex!(a::WrappedArray{NDIMS, T, A, WA}, x,
+                        idcs...) where {NDIMS, T,
+                                        A <: AbstractVector{T}, WA}
+    a.a[convert_index(a, idcs)] = x
+end
+end # @muladd
diff --git a/src/solvers/fsbp/fsbp.jl b/src/solvers/fsbp/fsbp.jl
new file mode 100644
index 0000000..c07bce3
--- /dev/null
+++ b/src/solvers/fsbp/fsbp.jl
@@ -0,0 +1,75 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+include("containers.jl")
+
+abstract type FSBPBasis end
+
+include("cell_basis.jl")
+include("cell_basis_constructors.jl")
+
+"""
+    PerCellBasis{CellBasisConstructorT}
+
+Each cell of the mesh has its own CellBasis. Holds only the `local_basis_constructor`
+that builds the basis of each cell; everything else is delegated to the bases of the
+individual cells/elements.
+"""
+struct PerCellBasis{CellBasisConstructorT} <:
+       FSBPBasis
+    local_basis_constructor::CellBasisConstructorT
+end
+
+function PerCellBasis(local_basis_constructor::CellBasisConstructorT) where
+         {
+          CellBasisConstructorT <:
+          CellBasisConstructor
+          }
+    PerCellBasis{CellBasisConstructorT}(local_basis_constructor)
+end
+
+const DGFSBP = DG{Basis} where {Basis <: FSBPBasis}
+
+function DGFSBP(cell_basis_constructor;
+                basis = PerCellBasis(cell_basis_constructor),
+                surface_flux = flux_central,
+                surface_integral = SurfaceIntegralWeakForm(surface_flux),
+                volume_integral = VolumeIntegralFluxDifferencing(),
+                mortar = nothing)
+    return DG{typeof(basis), typeof(mortar), typeof(surface_integral),
+              typeof(volume_integral)}(basis, mortar, surface_integral, volume_integral)
+end
+
+@inline Base.real(::PerCellBasis{CellBasisConstructorT}) where {
+RealT,
+CellBasisT <: CellBasis{RealT},
+CellBasisConstructorT <: CellBasisConstructor{CellBasisT}
+} = RealT
+
+struct PerCellAnalyzer{RealT <: Real} <:
+       SolutionAnalyzer{RealT}
+    analysis_polydeg::Any
+end
+
+"""
+    SolutionAnalyzer(basis::PerCellBasis; analysis_polydeg = nothing)
+
+SolutionAnalyzer for spatially varying bases.
+
+- `analysis_polydeg == nothing`: no interpolation; compares the numerical solution to the
+  exact solution at the basis nodes.
+- `analysis_polydeg == n::Int`: evaluates the exact solution and interpolates the numerical
+  solution at n + 1 Gauss-Lobatto nodes per element and compares them there. 1D only; on a
+  2D mesh this errors.
+"""
+function SolutionAnalyzer(basis::PerCellBasis; analysis_polydeg = nothing)
+    RealT = real(basis)
+    return PerCellAnalyzer{RealT}(analysis_polydeg)
+end
+
+include("calc_volume_integral.jl")
+end # @muladd
diff --git a/src/solvers/fsbp_tree/containers.jl b/src/solvers/fsbp_tree/containers.jl
new file mode 100644
index 0000000..5389c30
--- /dev/null
+++ b/src/solvers/fsbp_tree/containers.jl
@@ -0,0 +1,104 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+# `NDIMSP2` is `NDIMS + 2`, the rank of `surface_flux_values`; Julia cannot compute it
+# inside the type, so it is carried as a parameter (as in `P4estElementContainer`).
+struct TreeElementBasisContainer{NDIMS, RealT <: Real, uEltype <: Real, CellBasisT,
+                                 NDIMSP2} <: AbstractTreeElementContainer
+    bases::Vector{CellBasisT}                        # [elements]
+    nvars::Int
+    num_nodes_in_element::Vector{NTuple{NDIMS, Int}} # per axis, per element
+    offsets::Vector{Int}                             # element starts in the flat vector
+    # [variables, face node..., direction, elements]
+    surface_flux_values::Array{uEltype, NDIMSP2}
+    cell_ids::Vector{Int}                            # [elements]
+    _surface_flux_values::Vector{uEltype}             # internal `resize!`able storage
+end
+
+const TreeElementBasisContainer1D = TreeElementBasisContainer{1}
+const TreeElementBasisContainer2D = TreeElementBasisContainer{2}
+
+# `n_face_nodes` (max node count over all elements/axes) sizes the face dimensions of
+# `surface_flux_values`; in 1D there are none and it is ignored.
+function TreeElementBasisContainer{NDIMS, RealT, uEltype, CellBasisT}(bases, nvars,
+                                                                      num_nodes_in_element,
+                                                                      offsets, cell_ids,
+                                                                      n_face_nodes) where {
+                                                                                           NDIMS,
+                                                                                           RealT <:
+                                                                                           Real,
+                                                                                           uEltype <:
+                                                                                           Real,
+                                                                                           CellBasisT
+                                                                                           }
+    capacity = length(bases)
+    dims = (nvars, ntuple(_ -> n_face_nodes, Val(NDIMS - 1))..., 2 * NDIMS, capacity)
+
+    _surface_flux_values = fill(convert(uEltype, NaN), prod(dims))
+    surface_flux_values = unsafe_wrap(Array, pointer(_surface_flux_values), dims)
+
+    return TreeElementBasisContainer{NDIMS, RealT, uEltype, CellBasisT, NDIMS + 2}(bases,
+                                                                                   nvars,
+                                                                                   num_nodes_in_element,
+                                                                                   offsets,
+                                                                                   surface_flux_values,
+                                                                                   collect(Int,
+                                                                                           cell_ids),
+                                                                                   _surface_flux_values)
+end
+
+@inline Base.real(::TreeElementBasisContainer{NDIMS, RealT}) where {NDIMS,
+RealT} = RealT
+
+@inline nelements(elements::TreeElementBasisContainer) = length(elements.bases)
+
+"""
+    eachelement(elements::TreeElementBasisContainer)
+
+Return an iterator over the indices that specify the location in relevant data structures
+for the elements in `elements`.
+In particular, not the elements themselves are returned.
+"""
+@inline function eachelement(elements::TreeElementBasisContainer)
+    Base.OneTo(nelements(elements))
+end
+
+num_total_nodes(elements::TreeElementBasisContainer) = elements.offsets[end] ÷
+                                                       elements.nvars
+
+function wrap_array(u_ode::AbstractVector, mesh::AbstractMesh, equations,
+                    dg::DGFSBP, cache)
+    WrappedArray(Val(index_ndims(eltype(cache.elements.bases))), nvariables(equations),
+                 cache.elements.num_nodes_in_element,
+                 cache.elements.offsets, u_ode)
+end
+
+function allocate_coefficients(::AbstractMesh, equations, ::DGFSBP, cache)
+    # We must allocate a `Vector` in order to be able to `resize!` it (AMR).
+    # cf. wrap_array
+    u_ode = fill(zero(eltype(cache.elements)),
+                 nvariables(equations) * num_total_nodes(cache.elements))
+    return u_ode
+end
+
+# The generic `set_zero!` calls `du[.., element]`, which allocates a view per element.
+# Directly zeroing the flat backing vector avoids all allocations.
+# `trixi_backend(::WrappedArray)` is always `nothing`, so this covers every case.
+function set_zero!(::Nothing, du::WrappedArray, dg::DGFSBP, cache)
+    fill!(du.a, zero(eltype(du)))
+    return nothing
+end
+
+@inline nelements(mesh, dg::DGFSBP, cache) = nelements(cache.elements)
+@inline function ndofsglobal(mesh, dg::DGFSBP, cache)
+    num_total_nodes(cache.elements)
+end
+
+@inline function ndofs(mesh::MeshesDGSEM, dg::DGFSBP, cache)
+    num_total_nodes(cache.elements)
+end
+end # @muladd
diff --git a/src/solvers/fsbp_tree/containers_1d.jl b/src/solvers/fsbp_tree/containers_1d.jl
new file mode 100644
index 0000000..dc4619a
--- /dev/null
+++ b/src/solvers/fsbp_tree/containers_1d.jl
@@ -0,0 +1,93 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+@inline eachnode(::DGFSBP, elements::TreeElementBasisContainer1D,
+element) = Base.OneTo(elements.num_nodes_in_element[element][1])
+@inline nnodes(::DGFSBP, elements::TreeElementBasisContainer1D,
+element) = elements.num_nodes_in_element[element][1]
+@inline nnodes(elements::TreeElementBasisContainer1D,
+element) = elements.num_nodes_in_element[element][1]
+
+# Create element container and initialize element data.
+function init_elements(cell_ids, mesh::TreeMesh1D,
+                       equations::AbstractEquations{1},
+                       basis::PerCellBasis,
+                       ::Type{RealT},
+                       ::Type{uEltype}) where {RealT <: Real, uEltype <: Real}
+    n_elements = length(cell_ids)
+    CellBasisT = cell_basis_type(typeof(basis.local_basis_constructor))
+
+    bases = Vector{CellBasisT}(undef, n_elements)
+    num_nodes_in_element = Vector{NTuple{1, Int}}(undef, n_elements)
+    offsets = Vector{Int}(undef, n_elements + 1)
+    offsets[1] = 0
+    n_vars = nvariables(equations)
+
+    for element in 1:n_elements
+        cell_id = cell_ids[element]
+        dx = length_at_cell(mesh.tree, cell_id)
+        cell_basis = build_cell_basis(basis.local_basis_constructor,
+                                      mesh.tree.coordinates[1, cell_id], dx)
+
+        bases[element] = cell_basis
+        num_nodes_in_element[element] = (nnodes(cell_basis),)
+        offsets[element + 1] = offsets[element] +
+                               n_vars * ndofs_per_element(cell_basis)
+    end
+
+    return TreeElementBasisContainer{1, RealT, uEltype, CellBasisT}(bases, n_vars,
+                                                                    num_nodes_in_element,
+                                                                    offsets, cell_ids,
+                                                                    1)
+end
+
+function init_interfaces(cell_ids, mesh::TreeMesh1D,
+                         elements::TreeElementBasisContainer1D)
+    n_interfaces = count_required_interfaces(mesh, cell_ids)
+    interfaces = TreeInterfaceContainer1D{eltype(elements)}(n_interfaces,
+                                                            nvariables(elements))
+    init_interfaces!(interfaces, elements, mesh)
+    return interfaces
+end
+
+function init_boundaries(cell_ids, mesh::TreeMesh1D,
+                         elements::TreeElementBasisContainer1D, basis)
+    n_boundaries = count_required_boundaries(mesh, cell_ids)
+    boundaries = TreeBoundaryContainer1D{real(elements), eltype(elements)}(n_boundaries,
+                                                                           nvariables(elements))
+    init_boundaries!(boundaries, elements, mesh, basis)
+    return boundaries
+end
+
+@inline function get_node_coords(elements::TreeElementBasisContainer1D, i, element)
+    SVector(get_nodes(elements.bases[element])[i])
+end
+
+@inline function get_node_coords(elements::TreeElementBasisContainer1D, equations,
+                                 solver::DG, indices...)
+    get_node_coords(elements, indices...)
+end
+
+@inline function boundary_node_coordinate(elements::TreeElementBasisContainer1D,
+                                          element,
+                                          direction)
+    basis = elements.bases[element]
+    if direction == 1
+        return SVector(boundary_coordinate(basis, Negative()))
+    else
+        return SVector(boundary_coordinate(basis, Positive()))
+    end
+end
+
+function calc_boundary_node_coordinates!(boundaries, element, count, direction,
+                                         elements::TreeElementBasisContainer1D,
+                                         mesh::TreeMesh1D, basis)
+    boundaries.node_coordinates[:, count] .= boundary_node_coordinate(elements, element,
+                                                                      direction)
+    return nothing
+end
+end # @muladd
diff --git a/src/solvers/fsbp_tree/containers_2d.jl b/src/solvers/fsbp_tree/containers_2d.jl
new file mode 100644
index 0000000..518b20a
--- /dev/null
+++ b/src/solvers/fsbp_tree/containers_2d.jl
@@ -0,0 +1,123 @@
+# By default, Julia/LLVM does not use fused multiply-add operations (FMAs).
+# Since these FMAs can increase the performance of many numerical algorithms,
+# we need to opt-in explicitly.
+# See https://ranocha.de/blog/Optimizing_EC_Trixi for further details.
+@muladd begin
+#! format: noindent
+
+# Create element container and initialize element data.
+function init_elements(cell_ids, mesh::TreeMesh2D,
+                       equations::AbstractEquations{2},
+                       basis::PerCellBasis,
+                       ::Type{RealT},
+                       ::Type{uEltype}) where {RealT <: Real, uEltype <: Real}
+    n_elements = length(cell_ids)
+    # One tensor-product basis per element; a bare 1D constructor is wrapped isotropically.
+    tensor_ctor = as_tensor(basis.local_basis_constructor, Val(2))
+    CellBasisT = cell_basis_type(typeof(tensor_ctor))
+
+    bases = Vector{CellBasisT}(undef, n_elements)
+    num_nodes_in_element = Vector{NTuple{2, Int}}(undef, n_elements)
+    offsets = Vector{Int}(undef, n_elements + 1)
+    offsets[1] = 0
+    n_vars = nvariables(equations)
+    n_face_nodes = 0
+
+    for element in 1:n_elements
+        cell_id = cell_ids[element]
+        dx = length_at_cell(mesh.tree, cell_id)
+        pos = view(mesh.tree.coordinates, :, cell_id)
+        # TreeMesh cells are square: identical width on both axes
+        tp = build_cell_basis(tensor_ctor, pos, (dx, dx))
+
+        bases[element] = tp
+        nn = map(nnodes, tp.bases)
+        num_nodes_in_element[element] = nn
+        offsets[element + 1] = offsets[element] + n_vars * ndofs_per_element(tp)
+        n_face_nodes = max(n_face_nodes, maximum(nn))
+    end
+
+    return TreeElementBasisContainer{2, RealT, uEltype, CellBasisT}(bases, n_vars,
+                                                                    num_nodes_in_element,
+                                                                    offsets, cell_ids,
+                                                                    n_face_nodes)
+end
+
+# Both sides of an interface are indexed with the left element's tangential basis.
+# TODO: lift by interpolating between the two tangential bases.
+function check_conforming_faces(interfaces, elements)
+    for interface in eachinterface(interfaces)
+        left_element = interfaces.neighbor_ids[1, interface]
+        right_element = interfaces.neighbor_ids[2, interface]
+        tangential = interfaces.orientations[interface] == 1 ? 2 : 1
+        b_l = elements.bases[left_element].bases[tangential]
+        b_r = elements.bases[right_element].bases[tangential]
+        h = boundary_coordinate(b_l, Positive()) - boundary_coordinate(b_l, Negative())
+        if nnodes(b_l) != nnodes(b_r) ||
+           !isapprox(get_nodes(b_l), get_nodes(b_r), atol = sqrt(eps(typeof(h))) * h)
+            error("DGFSBP on TreeMesh{2} requires conforming faces, but elements " *
+                  "$left_element and $right_element share an interface with " *
+                  "different tangential node counts or positions")
+        end
+    end
+    return nothing
+end
+
+# Reuse the DGSEM 2D interface/boundary containers; the face-node count is taken from
+# `surface_flux_values`.
+function init_interfaces(cell_ids, mesh::TreeMesh2D,
+                         elements::TreeElementBasisContainer2D)
+    n_interfaces = count_required_interfaces(mesh, cell_ids)
+    n_face_nodes = size(elements.surface_flux_values, 2)
+    interfaces = TreeInterfaceContainer2D{eltype(elements)}(n_interfaces,
+                                                            nvariables(elements),
+                                                            n_face_nodes)
+    init_interfaces!(interfaces, elements, mesh)
+    check_conforming_faces(interfaces, elements)
+    return interfaces
+end
+
+function init_boundaries(cell_ids, mesh::TreeMesh2D,
+                         elements::TreeElementBasisContainer2D, basis)
+    n_boundaries = count_required_boundaries(mesh, cell_ids)
+    n_face_nodes = size(elements.surface_flux_values, 2)
+    boundaries = TreeBoundaryContainer2D{real(elements), eltype(elements)}(n_boundaries,
+                                                                           nvariables(elements),
+                                                                           n_face_nodes)
+    init_boundaries!(boundaries, elements, mesh, basis)
+    return boundaries
+end
+
+@inline function get_node_coords(elements::TreeElementBasisContainer2D, i, j, element)
+    bx, by = elements.bases[element].bases
+    return SVector(get_nodes(bx)[i], get_nodes(by)[j])
+end
+
+@inline function get_node_coords(elements::TreeElementBasisContainer2D, equations,
+                                 solver::DG, indices...)
+    get_node_coords(elements, indices...)
+end
+
+# Boundary face nodes: normal axis pinned to the element boundary, tangential axis over its
+# nodes.
+function calc_boundary_node_coordinates!(boundaries, element, count, direction,
+                                         elements::TreeElementBasisContainer2D,
+                                         mesh::TreeMesh2D, basis)
+    bx, by = elements.bases[element].bases
+    bnd = boundaries.node_coordinates
+    if direction == 1 || direction == 2       # x-face: tangential runs over y
+        x = boundary_coordinate(bx, direction == 1 ? Negative() : Positive())
+        for j in eachnode(by)
+            bnd[1, j, count] = x
+            bnd[2, j, count] = get_nodes(by)[j]
+        end
+    else                                       # y-face: tangential runs over x
+        y = boundary_coordinate(by, direction == 3 ? Negative() : Positive())
+        for i in eachnode(bx)
+            bnd[1, i, count] = get_nodes(bx)[i]
+            bnd[2, i, count] = y
+        end
+    end
+    return nothing
+end
+end # @muladd
